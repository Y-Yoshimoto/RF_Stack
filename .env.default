# docker-compose env file
TZ="Asia/Tokyo"

# Additional: [UID, GID] for docker-compose
USER_ID=1000
GROUP_ID=20

# FaseAPI Proxyy URL
TARGET_API_BASE_URL=http://fastapi_app

# KeyCloak (Dev)
KEYCLOAK_URL=http://keycloak_c:8080
KEYCLOAK_EXTERNAL_URL=http://localhost:8080
KEYCLOAK_HTTP_RELATIVE_PATH=keycloak
# BFF の OIDC クライアント ID。AP はテナントレルム (tenant-{tenant_code})、CP は control-plane レルムのクライアント。
KEYCLOAK_CLIENT_ID=fastapi-app
KEYCLOAK_CP_CLIENT_ID=fastapi-cp
# クライアントシークレットは保存せず、このシードから導出する (02 §3.3)。
#   secret = base64url_nopad(HMAC-SHA256(KC_CLIENT_SECRET_SEED, "{realm}:{client_id}"))
# 払い出し・CLI (python -m modules.keycloak_admin.cli) がこの値でクライアントに設定し、BFF も同じ値を導出する。
# 開発用の既定値のままの場合、APP_ENV=development では警告、それ以外では起動時にエラーになる。
# 変更した場合は、全レルムで CLI / 払い出しのシークレット同期を再実行する。
# (旧 KEYCLOAK_CLIENT_SECRET は廃止。手元の .env から削除してよい)
KC_CLIENT_SECRET_SEED=change-me-client-secret-seed
# テナント払い出し (CP) が Keycloak Admin API を呼ぶためのサービスアカウント (master レルム、create-realm のみ)。
# APP_ENV=development では使わず、KC_BOOTSTRAP_ADMIN_* (master / admin-cli のパスワードグラント) を使う。
# development 以外では SECRET が必須 (未設定なら払い出しがエラーになる)。開発用の既定値は無い。
KEYCLOAK_PROVISIONER_CLIENT_ID=cp-provisioner
KEYCLOAK_PROVISIONER_CLIENT_SECRET=
APP_CALLBACK_URL=http://localhost:5173/api/auth/callback
FRONTEND_URL=http://localhost:5173

# KeyCloak
# https://www.keycloak.org/server/all-config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_PROXY_HEADER=xforwarded
KC_HTTP_RELATIVE_PATH=keycloak

# アプリケーション実行環境 (development / production)
# development 以外では、既定のままの秘密鍵を検出すると起動時に失敗する。
# あわせてセッション Cookie の Secure 属性もこの値から導出される。
APP_ENV=development

# 開発用ログインバイパス (/api/auth/dev-login)。
# 認証済みセッションを無条件に発行するため、APP_ENV=development でのみ有効。
# 本番相当の環境で true にすると起動時にエラーになる。
AUTH_DEV_LOGIN_ENABLED=true

# CORS を許可するオリジン (カンマ区切り)。
# 通常は Vite proxy 経由で同一オリジンになるため不要。空の場合 CORS は無効。
# ブラウザから FastAPI に直接アクセスする構成でのみ設定する。
CORS_ALLOW_ORIGINS=

# CSRF 対策: 変更系リクエスト (POST 等) で許可する Origin (カンマ区切り)。
# FRONTEND_URL のオリジンは常に許可される。vite preview (http://localhost:4173) など
# 別オリジンから操作する場合のみ追加する。
CSRF_TRUSTED_ORIGINS=

# Session (Redis)
REDIS_URL=redis://redis_c:6379/0
SESSION_SECRET_KEY=change-me-session-secret
SESSION_TTL_SECONDS=3600


# PostgreSQL
## 標準ユーザー
POSTGRES_PASSWORD=postgres
# 注意: 旧 APP_DB_USER / APP_DB_PASSWORD は廃止(ロール分離)。手元の .env から削除し、postgres_c のボリューム再作成が必要。
# 以下は開発用ダミー値。本番では必ず変更し、実行時ロール以外の資格情報はアプリケーションに渡さない。
### コントロールプレーン用ロール
CP_DB_OWNER_USER=cp_owner
CP_DB_OWNER_PASSWORD=cp_owner_password
CP_DB_RUNTIME_USER=cp_runtime
CP_DB_RUNTIME_PASSWORD=cp_runtime_password
CP_DB_REGISTRY_READER_USER=cp_registry_reader
CP_DB_REGISTRY_READER_PASSWORD=cp_registry_reader_password
### アプリケーションプレーン用ロール
APP_DB_OWNER_USER=app_owner
APP_DB_OWNER_PASSWORD=app_owner_password
APP_DB_RUNTIME_USER=app_runtime
APP_DB_RUNTIME_PASSWORD=app_runtime_password
APP_DB_CP_AGENT_USER=app_cp_agent
APP_DB_CP_AGENT_PASSWORD=app_cp_agent_password
# アプリケーション用データベース
APP_DB_NAME=app_db
### コントロールプレーン用データベース
CONTROL_PLANE_DB_NAME=control_plane_db

# 定期ジョブのスケジューラ(true/false)。空なら APP_ENV=development では無効、それ以外では有効
SCHEDULER_ENABLED=
