# docker-compose env file
TZ="Asia/Tokyo"

# Additional: [UID, GID] for docker-compose
USER_ID=1000
GROUP_ID=20

# FaseAPI Proxyy URL
TARGET_API_BASE_URL=http://fastapi_app

# KeyCloak (Dev)
KEYCLOAK_URL=http://keycloak_c:8080
KEYCLOAK_EXTERNAL_URL=http://localhost:8080
KEYCLOAK_HTTP_RELATIVE_PATH=keycloak
KEYCLOAK_CLIENT_ID=fastapi-app
KEYCLOAK_CLIENT_SECRET=change-me
APP_CALLBACK_URL=http://localhost:5173/api/auth/callback
FRONTEND_URL=http://localhost:5173

# KeyCloak
# https://www.keycloak.org/server/all-config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_PROXY_HEADER=xforwarded
KC_HTTP_RELATIVE_PATH=keycloak

# アプリケーション実行環境 (development / production)
# development 以外では、既定のままの秘密鍵を検出すると起動時に失敗する。
# あわせてセッション Cookie の Secure 属性もこの値から導出される。
APP_ENV=development

# 開発用ログインバイパス (/api/auth/dev-login)。
# 認証済みセッションを無条件に発行するため、APP_ENV=development でのみ有効。
# 本番相当の環境で true にすると起動時にエラーになる。
AUTH_DEV_LOGIN_ENABLED=true

# CORS を許可するオリジン (カンマ区切り)。
# 通常は Vite proxy 経由で同一オリジンになるため不要。空の場合 CORS は無効。
# ブラウザから FastAPI に直接アクセスする構成でのみ設定する。
CORS_ALLOW_ORIGINS=

# Session (Redis)
REDIS_URL=redis://redis_c:6379/0
SESSION_SECRET_KEY=change-me-session-secret
SESSION_TTL_SECONDS=3600


# PostgreSQL
## 標準ユーザー
POSTGRES_PASSWORD=postgres
### アプリケーション/コントロールプレーン用ユーザー
APP_DB_USER=app_db_user
APP_DB_PASSWORD=app_db_password
# アプリケーション用データベース
APP_DB_NAME=app_db
### コントロールプレーン用
CONTROL_PLANE_DB_NAME=control_plane_db
