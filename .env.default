# docker-compose env file
TZ="Asia/Tokyo"

# FaseAPI Proxyy URL
TARGET_API_BASE_URL=http://fastapi_app

# KeyCloak (Dev)
KEYCLOAK_URL=http://keycloak_c:8080
KEYCLOAK_EXTERNAL_URL=http://localhost:8080
KEYCLOAK_HTTP_RELATIVE_PATH=keycloak
KEYCLOAK_CLIENT_ID=fastapi-app
KEYCLOAK_CLIENT_SECRET=change-me
APP_CALLBACK_URL=http://localhost:5173/api/auth/callback
FRONTEND_URL=http://localhost:5173

# Session (Redis)
REDIS_URL=redis://redis_c:6379/0
SESSION_SECRET_KEY=change-me-session-secret
SESSION_TTL_SECONDS=3600

# Additional: [UID, GID] for docker-compose
# GUI: 20
USER_ID=1000
GROUP_ID=20

# PostgreSQL
## 標準ユーザー
POSTGRES_PASSWORD=postgres
### アプリケーション/コントロールプレーン用ユーザー
APP_DB_USER=app_db_user
APP_DB_PASSWORD=app_db_password
# アプリケーション用データベース
APP_DB_NAME=app_db
### コントロールプレーン用
CONTROL_PLANE_DB_NAME=control_plane_db
