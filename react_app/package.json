{
  "name": "react-template",
  "description": "React portal template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "npm run build:production && vite preview",
    "lint": "eslint . --max-warnings 0 --config eslint.config.js",
    "lint:complexity": "eslint . --config ./auxiliary/eslint_CC.config.js",
    "lint:report": "eslint . --format html --output-file eslint-report.html --config eslint.config.js",
    "lint:fix": "eslint . --max-warnings 0 --fix --config eslint.config.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage --silent",
    "playwright": "playwright test",
    "playwright:ui": "playwright test --ui-host=0.0.0.0",
    "playwright:codegen": "playwright codegen ",
    "playwright:report": "playwright show-report --port 9323",
    "nyc": "nyc report --reporter=html",
    "nyc:report": "nyc report --reporter=html",
    "madge": "node ./auxiliary/visualization-madge.js",
    "update": "ncu -u && rm package-lock.json && npm install"
  },
  "__comments_scripts": [
    "dev, build, preview: Viteの開発サーバー、ビルド、プレビューを実行",
    "lint: ESLint(CLI, HTMLレポート出力、修正)を実行",
    "test: Vitestでユニットテストを実行",
    "coverage: Vitestでカバレッジレポートを生成",
    "playwright: PlaywrightでE2Eテストを実行",
    "nyc: 別生成したNYCでカバレッジレポートを生成",
    "madge: madgeを使って依存関係の可視化を生成",
    "update: npm-check-updatesを使って依存関係を更新"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-router": "^7.9.1",
    "react-router-dom": "^7.9.1",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@react-router/dev": "^7.9.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.4.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "madge": "^8.0.0",
    "npm-check-updates": "^18.1.1",
    "nyc": "^17.1.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "tsx": "4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vitest-browser-react": "^1.0.1"
  },
  "browserslist": [
    "defaults"
  ]
}