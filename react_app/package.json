{
  "name": "react-template",
  "description": "React portal template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "npm run build:production && vite preview",
    "lint": "eslint . --max-warnings 0 --config eslint.config.js",
    "lint:complexity": "eslint . --config ./auxiliary/eslint_CC.config.js",
    "lint:report": "eslint . --format html --output-file eslint-report.html --config eslint.config.js",
    "lint:fix": "eslint . --max-warnings 0 --fix --config eslint.config.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage --silent",
    "playwright": "playwright test",
    "playwright:ui": "playwright test --ui-host=0.0.0.0",
    "playwright:codegen": "playwright codegen ",
    "playwright:report": "playwright show-report --port 9323",
    "nyc": "nyc report --reporter=html",
    "nyc:report": "nyc report --reporter=html",
    "madge": "node ./auxiliary/visualization-madge.js",
    "update": "ncu -u && rm package-lock.json && rm -r node_modules && npm install --include=dev && playwright install chromium chromium-headless-shell webkit",
    "update:force": "ncu -u --force && rm package-lock.json && rm -r node_modules && npm install --include=dev --force && playwright install chromium chromium-headless-shell webkit",
    "storybook": "storybook dev -p 6006",
    "storybook:no-open": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "__comments_scripts": [
    "dev, build, preview: Viteの開発サーバー、ビルド、プレビューを実行",
    "lint: ESLint(CLI, HTMLレポート出力、修正)を実行",
    "test: Vitestでユニットテストを実行",
    "coverage: Vitestでカバレッジレポートを生成",
    "playwright: PlaywrightでE2Eテストを実行",
    "nyc: 別生成したNYCでカバレッジレポートを生成",
    "madge: madgeを使って依存関係の可視化を生成",
    "update: npm-check-updatesを使って依存関係を更新"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "^7.13.1",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-onboarding": "^10.2.19",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.2.19",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "madge": "^8.0.0",
    "npm-check-updates": "^19.6.3",
    "nyc": "^18.0.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.2.19",
    "tsx": "4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0",
    "vitest-browser-react": "^2.1.0"
  },
  "browserslist": [
    "defaults"
  ]
}
